{
  "name": "edimp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm run --prefix packages/database generate",
    "build": "npm run db:generate && turbo run build",
    "dev": "turbo run dev",
    "lint": "npm run --prefix apps/web lint",
    "typecheck": "npm run --prefix apps/web lint",
    "test": "npm run --prefix apps/api test",
    "test:e2e": "npm run --prefix apps/api test:e2e"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "npm@10.8.2"
}
